# Server
PORT=3001
# Comma-separated browser origins allowed to call the API directly.
# Local Vite development uses the /api proxy and does not need this entry.
# Production: https://citizenshipai.us,https://www.citizenshipai.us
CORS_ORIGIN=http://localhost:5173

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini

# Accounts and server-authoritative AI usage (Supabase)
# Keep SUPABASE_SECRET_KEY on the private Render service only. Never prefix it
# with VITE_ and never expose it in the browser or mobile bundle.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The publishable key will be used by the client in a later authentication phase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# USCIS Case Status API
# Keep this set to sandbox until USCIS grants separate Production credentials
# and endpoints. The application never guesses Production URLs.
USCIS_ENV=sandbox
# Minimum wait between manual Case Tracker refreshes from one requester.
USCIS_MANUAL_COOLDOWN_SECONDS=60
USCIS_SANDBOX_CLIENT_ID=
USCIS_SANDBOX_CLIENT_SECRET=
# Optional Sandbox endpoint overrides. These defaults are used when omitted.
# USCIS_SANDBOX_TOKEN_URL=https://api-int.uscis.gov/oauth/accesstoken
# USCIS_SANDBOX_API_URL=https://api-int.uscis.gov/case-status
# Legacy Sandbox names remain supported for the current deployment:
# USCIS_CLIENT_ID=
# USCIS_CLIENT_SECRET=
# USCIS_TOKEN_URL=
# USCIS_API_URL=
# Add these only after USCIS provides Production access; do not reuse Sandbox values.
# USCIS_PRODUCTION_CLIENT_ID=
# USCIS_PRODUCTION_CLIENT_SECRET=
# USCIS_PRODUCTION_TOKEN_URL=
# USCIS_PRODUCTION_API_URL=

# Frontend build only when the API is hosted separately.
# VITE_API_BASE_URL=https://api.citizenshipai.us
# VITE_ALLOWED_HOSTS=citizenshipai.us,www.citizenshipai.us
# For local development, add a named development tunnel host only when needed.
# VITE_ALLOWED_HOSTS=
# VITE_DEV_API_TARGET=http://127.0.0.1:3001
