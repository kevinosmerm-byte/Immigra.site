# Server
PORT=3001
# Comma-separated browser origins allowed to call the API directly.
# Local Vite development uses the /api proxy and does not need this entry.
# Production: https://citizenshipai.us,https://www.citizenshipai.us
CORS_ORIGIN=http://localhost:5173

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini

# Accounts and server-authoritative AI usage (Supabase)
# Keep SUPABASE_SECRET_KEY on the private Render service only. Never prefix it
# with VITE_ and never expose it in the browser or mobile bundle.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Server only: 32 random bytes, base64 encoded, for optional encrypted profiles.
PROFILE_ENCRYPTION_KEY=
# The publishable key will be used by the client in a later authentication phase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web subscriptions (Stripe Checkout + Customer Portal)
# Keep all STRIPE_* secrets on the private Render service. Start in Stripe test mode.
# Checkout remains unavailable unless this flag is true and every required value exists.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
# Optional dedicated recurring test/live Price for the $4.99 launch offer.
# When omitted, Checkout and the account screen both use the regular $5.99 price.
STRIPE_PRICE_MONTHLY_INTRO=
STRIPE_PRICE_ANNUAL=
# Enable only after Stripe Tax registrations and settings have been reviewed.
STRIPE_AUTOMATIC_TAX=false
APP_BASE_URL=https://citizenshipai.us

# Scheduling rollout. Shadow computes comparisons but keeps legacy scheduling visible.
VITE_TS_FSRS_SHADOW=false
# Keep false until shadow telemetry has been reviewed and the ts-fsrs adapter is validated.
VITE_TS_FSRS_ACTIVE=false

# Optional official Congress.gov API key for current senators/representatives.
CONGRESS_API_KEY=

# Optional state legislators (server only; never expose these keys in VITE_*).
OPENSTATES_API_KEY=
# Optional verified governor JSON feed. Set only to a real authoritative HTTPS
# government/NGA source conforming to docs/CIVIC_PROVIDERS.md; no guessed URL.
# GOVERNOR_DATA_URL=

# USCIS Case Status API
# Keep this set to sandbox until USCIS grants separate Production credentials
# and endpoints. The application never guesses Production URLs.
USCIS_ENV=sandbox
# Minimum wait between manual Case Tracker refreshes from one requester.
USCIS_MANUAL_COOLDOWN_SECONDS=60
USCIS_SANDBOX_CLIENT_ID=
USCIS_SANDBOX_CLIENT_SECRET=
# Optional Sandbox endpoint overrides. These defaults are used when omitted.
# USCIS_SANDBOX_TOKEN_URL=https://api-int.uscis.gov/oauth/accesstoken
# USCIS_SANDBOX_API_URL=https://api-int.uscis.gov/case-status
# Legacy Sandbox names remain supported for the current deployment:
# USCIS_CLIENT_ID=
# USCIS_CLIENT_SECRET=
# USCIS_TOKEN_URL=
# USCIS_API_URL=
# Add these only after USCIS provides Production access; do not reuse Sandbox values.
# USCIS_PRODUCTION_CLIENT_ID=
# USCIS_PRODUCTION_CLIENT_SECRET=
# USCIS_PRODUCTION_TOKEN_URL=
# USCIS_PRODUCTION_API_URL=

# Frontend build only when the API is hosted separately.
# VITE_API_BASE_URL=https://api.citizenshipai.us
# VITE_ALLOWED_HOSTS=citizenshipai.us,www.citizenshipai.us
# For local development, add a named development tunnel host only when needed.
# VITE_ALLOWED_HOSTS=
# VITE_DEV_API_TARGET=http://127.0.0.1:3001

# Native purchases: keep disabled until sandbox verification and DB migration.
NATIVE_BILLING_ENABLED=false
# Server-only base64 encoding of a random 32-byte AES key. Keep a private backup.
NATIVE_PURCHASE_ENCRYPTION_KEY=
APPLE_PRODUCT_MONTHLY=immigra.pro.monthly
APPLE_PRODUCT_ANNUAL=immigra.pro.annual
APPLE_STORE_ENVIRONMENT=Sandbox
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_APP_ID=
APPLE_PRIVATE_KEY_FILE=
# Comma-separated paths to trusted official Apple root certificates on the server.
APPLE_ROOT_CERT_FILES=
GOOGLE_PRODUCT_MONTHLY=immigra_pro
GOOGLE_PRODUCT_ANNUAL=immigra_pro
GOOGLE_PLAN_MONTHLY=monthly
GOOGLE_PLAN_ANNUAL=annual
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ALLOW_TEST_PURCHASES=false
# Native API uses https://immigra.site/api. Add actual origins to CORS_ORIGIN.
# CORS_ORIGIN=https://immigra.site,capacitor://localhost,https://localhost
# APP_BASE_URL=https://immigra.site

# Optional native test build only: point to an isolated HTTPS sandbox backend.
# VITE_NATIVE_API_BASE_URL=https://immigra.site/api
