{
  "name": "immigration-ai",
  "version": "0.31.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm test && npm run build:app && npm run quality --prefix modules/citizenship && npm run verify:release",
    "test": "node --test tests/*.test.mjs modules/residency/tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "server:realtime": "node server/server.mjs",
    "start": "node start-all.mjs",
    "postinstall": "npm ci --prefix modules/citizenship --ignore-scripts",
    "build:app": "vite build && node scripts/build-public-pages.mjs",
    "verify:release": "npm run stores:verify && node scripts/verify-release.mjs",
    "verify:production": "node scripts/verify-release.mjs --production",
    "native:sync:android": "npm run build && npm run native:sync:android --prefix modules/citizenship",
    "native:sync:ios": "npm run build && npm run native:sync:ios --prefix modules/citizenship",
    "native:build:android": "node scripts/build-native.mjs android",
    "native:build:ios": "node scripts/build-native.mjs ios",
    "stores:verify": "node scripts/verify-store-package.mjs",
    "stores:package": "node scripts/package-store-submission.mjs"
  },
  "dependencies": {
    "vite": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
